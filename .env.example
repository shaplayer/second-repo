# Copy this file to .env on the server and fill it in. Never commit .env or paste keys into chat.
# After changing a NEXT_PUBLIC_ value, build again (npm run build): those are baked in at build time.

# ---------------------------------------------------------------- required

# The one database: Supabase Postgres. Supabase dashboard > Connect > "Session pooler" (port 5432).
# Not the transaction pooler (port 6543): migrations and backups need a full session.
DATABASE_URL=postgres://user:password@localhost:5432/bigstocks

# The path of Supabase's certificate file on this server (dashboard > Database settings > SSL Configuration >
# Download certificate). The connection to a database on another machine is always encrypted; with this
# line the server is also checked against the certificate. Not needed for a database on this machine.
# DATABASE_SSL_CA=/home/you/supabase-ca.crt

# The site's public address, no trailing slash. Used for the links in every email.
NEXT_PUBLIC_SITE_URL=https://bigstocks.com

# A long random secret of your own, used to sign small values the site hands to browsers.
# Make one with:  openssl rand -base64 48
APP_SECRET=

# SEC EDGAR asks every automated client to say who it is: your real company name and an email
# address that someone reads. There is no default: the worker and the scripts that contact the SEC
# refuse to run until this is set. https://www.sec.gov/os/accessing-edgar-data
# The shape (use your own):  SEC_USER_AGENT="Acme Research LLC sec-contact@acme-research.com"
SEC_USER_AGENT=

# Email (sign-in links, confirmations, alerts, picks). Resend: https://resend.com
#   resend   set RESEND_API_KEY; EMAIL_FROM must use a domain you verified in Resend
#   console  prints emails to the log instead of sending (development only)
#   smtp     any SMTP service (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS)
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_...
EMAIL_FROM="BigStocks <alerts@yourdomain.com>"
# From Resend > Webhooks, for the address https://<your site>/api/webhooks/resend (events: bounced, complained).
# With it, an address that bounces or marks us as spam is never emailed again.
# RESEND_WEBHOOK_SECRET=whsec_...

# Required by law (CAN-SPAM) in every alert email: your business postal address.
# Alert emails are held back until this is set to a real address.
COMPANY_POSTAL_ADDRESS=

# Plain-English summaries (Claude). Without it the site works but writes no AI summaries.
# ANTHROPIC_API_KEY=sk-ant-...

# Where sponsor inquiries from /advertise are emailed (comma-separated).
INQUIRY_NOTIFY_TO=sales@yourdomain.com

# ---------------------------------------------------------------- switches (leave as they are)

# Set to "off" to run everything except sending email (the side-by-side check before going live).
# ALERTS_SENDING=on

# The separate health check rules for young, unprofitable companies (approved Nov 13, 2026: on).
# Set to 0 to score every company with the standard rules again.
# HEALTH_GROWTH_RULES=1

# Text alerts. Off: the site shows no mobile field, collects no phone number, sends no text (plan decision 15).
# SMS_ENABLED=0
# Only so that STOP replies to the old site's number keep being honoured:
# TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------- only for the move from the two old sites

# The data site's own Postgres on the Droplet. It is only ever read. Remove once the move is finished.
# DATASITE_DATABASE_URL=postgres://user:password@localhost:5432/bigstocks_data
