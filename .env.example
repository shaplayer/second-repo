# The one database: Supabase Postgres. Supabase dashboard > Connect > "Session pooler" (port 5432).
# Not the transaction pooler (port 6543): migrations and backups need a full session.
DATABASE_URL=postgres://user:password@localhost:5432/bigstocks

# Only for the move from the two old sites (docs/RUNBOOK.md): the data site's own Postgres on the
# Droplet. It is only ever read. Remove this line once the move is finished.
# DATASITE_DATABASE_URL=postgres://user:password@localhost:5432/bigstocks_data

# SEC EDGAR asks every automated client to say who it is: your real company name and an email
# address that someone reads. There is no default: scripts that contact the SEC refuse to run
# until this is set. https://www.sec.gov/os/accessing-edgar-data
# Example of the shape (use your own): SEC_USER_AGENT="Acme Research LLC sec-contact@acme-research.com"
SEC_USER_AGENT=

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=https://bigstocks.com

# Ingest worker timing (seconds): SEC filings / newswires. Don't poll newswires faster than ~10 min.
# INGEST_INTERVAL_SEC=180
# PRESS_INTERVAL_SEC=600

# SMS text alerts: provider-neutral. Pick one:
#   console  - default; logs texts instead of sending (dev / before a vendor is chosen)
#   webhook  - POSTs each text to your own service (any vendor). See lib/sms/providers/webhook.ts
#   twilio   - built-in example adapter. See lib/sms/providers/twilio.ts
# New vendors: add a file in lib/sms/providers and register it in lib/sms/index.ts.
SMS_PROVIDER=console
# SMS_WEBHOOK_URL=https://your-sms-service.internal/send
# SMS_WEBHOOK_SECRET=long-random-string-at-least-16-chars
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_MESSAGING_SERVICE_SID=
# SMS_RATE_PER_SEC=10   # broadcast speed; match your provider throughput

# Track record API: your alert system logs alerts with this key (16+ chars)
ALERTS_API_KEY=

# Email (alert emails, company-follow emails, Advertise-form notifications)
#   resend  - Resend (resend.com): set RESEND_API_KEY; EMAIL_FROM must use a domain verified in Resend
#   console - default; logs the email instead of sending
#   smtp    - any SMTP service: Google Workspace, Microsoft 365, Amazon SES, SendGrid, Postmark, Mailgun...
#   webhook - POSTs each email to your own service. See lib/email/providers/webhook.ts
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_...
# EMAIL_BATCHES_PER_SEC=2   # alert emails go out 100 per request; match your Resend rate limit
INQUIRY_NOTIFY_TO=sales@yourdomain.com
EMAIL_FROM="BigStocks <no-reply@yourdomain.com>"
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_WEBHOOK_URL= / EMAIL_WEBHOOK_SECRET=

# Required in marketing email (CAN-SPAM): your business postal address, shown in every alert email footer
COMPANY_POSTAL_ADDRESS="BigStocks LLC, 123 Example St, City, ST 00000"

# Premium ($49/mo) checkout link from your payment provider. Empty = /premium shows a waitlist form.
NEXT_PUBLIC_PREMIUM_CHECKOUT_URL=

# /admin (send alerts): one shared password, 12+ characters. Leave empty to turn /admin off.
ADMIN_PASSWORD=
